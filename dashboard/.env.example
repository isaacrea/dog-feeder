# Copy to .env.local (gitignored) and edit. Never commit .env.local.
# Vite reads these when `npm run dev` starts: restart it after editing.

# mock = generated data, no network calls. live = your read API.
# Mock data exists only on the dev server; production builds are always live.
VITE_DATA_SOURCE=mock

# Mock only: normal | empty | error | slow (each exercises a UI state).
VITE_MOCK_SCENARIO=normal

# Read only by vite.config.js (Node); never sent to browsers.
FEEDER_API_URL=<InvokeUrl, e.g. https://abc123.execute-api.us-east-1.amazonaws.com/prod/feedingLogs>
FEEDER_API_KEY=<dashboard API key>

# Default color theme. The Theme button lets each viewer pick their own.
# auto (Sunset by day, Moonlight by night) | sunset | studio-light | moonlight | studio-dark
VITE_THEME=auto

# Match the stack's BatteryWarnVolts / BatteryCritVolts parameters.
VITE_BATTERY_WARN_VOLTS=3.60
VITE_BATTERY_CRIT_VOLTS=3.45
